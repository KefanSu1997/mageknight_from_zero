# Unity project .gitignore

# Core Unity generated folders
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Mm]emoryCaptures/
[Uu]ser[Ss]ettings/

# Unity caches and DBs
*.pidb
*.suo
*.user
*.userprefs
*.opendb
*.VC.db
*.mdb
*.pdb
*.tmp

# Editor/IDE specific
.vs/
.vscode/
.idea/
*.sln.iml

# Unity generated project/solution files
*.csproj
*.unityproj
*.sln
*.booproj
*.svd

# Platform / export related (Android/Gradle etc.)
[Gg]radle/
.gradle/
gradlew
gradlew.bat
ExportedObj/

# Build artifacts
*.apk
*.aab
*.unitypackage

# OS files
.DS_Store
Thumbs.db
nul

# Test outputs
TestResults.xml

# Tooling folders (local-only)
vibe_coding_tools/
/multi-agent-workspace/
/multi-agent-workspace/**
.ccr_bridge/
.claude/


# Project-specific: do NOT ignore Assets/, ProjectSettings/, Packages/
# Keep Packages/manifest.json and packages-lock.json tracked


# local secrets
.env

# Local runtime caches and recovery copies (already tracked history is preserved).
node_modules/
__pycache__/
*.pyc
/*.log
*.slnx
/Assets/_Recovery/
/Assets/_Recovery.meta

# Local RL models, trajectories, metrics and scene mapping evidence.
/AutomationOutputs/BattleRl/
/.venv_ui_text/
/.venv_rl/
!/tools/BattleRl/BattleRl.csproj

# Generated .NET tool outputs and local scratch data.
/tools/**/bin/
/tools/**/obj/
/tmp/

# These are hand-authored tool project files, not Unity-generated projects.
!/tools/**/*.csproj

# Automated run evidence stays local (user requested 2026-10-28).
/AutomationOutputs/
/AutomationLogs/
/vibe_coding/codex/checkpoints/*/evidence/
/vibe_coding/codex/checkpoints/*/evidence_manifest.json
