<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <DefineConstants>$(DefineConstants);NETSTANDARD2_1</DefineConstants>
    <NuGetAudit>false</NuGetAudit>
    <EnableTargetingPackDownload>false</EnableTargetingPackDownload>
    <EnableNETAnalyzers>false</EnableNETAnalyzers>
    <Nullable>annotations</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Assets/Logic/**/*.cs" Exclude="../../Assets/Logic/IsExternalInit.cs" />
    <Compile Include="../../Assets/Tests/RulesState/**/*.cs" />
    <Compile Include="../../Assets/Tests/CardCombatRulesTests.cs" />
    <Compile Include="../../Assets/Tests/CardMovementAndReadyTests.cs" />
    <Compile Include="../../Assets/Tests/CardWoundConservationTests.cs" />
    <Compile Include="../../Assets/Tests/PossessResolutionTests.cs" />
    <Compile Include="../../Assets/Tests/MistFormResolutionTests.cs" />
    <Compile Include="../../Assets/Tests/OriginalUnitDamageTests.cs" />
    <Compile Include="../../Assets/Tests/HeroSkillActivationTests.cs" />
    <Compile Include="../../Assets/Tests/ExplorationTests.cs" />
    <Compile Include="Program.cs" />
    <LocalJson Include="../../Library/PackageCache/com.unity.nuget.newtonsoft-json@*/Runtime/Newtonsoft.Json.dll" />
    <LocalNUnit Include="../../Library/PackageCache/com.unity.ext.nunit@*/net472/unity-custom/nunit.framework.dll" />
    <Reference Include="Newtonsoft.Json"><HintPath>@(LocalJson)</HintPath></Reference>
    <Reference Include="nunit.framework"><HintPath>@(LocalNUnit)</HintPath></Reference>
  </ItemGroup>
  <Target Name="RequireExistingDependencies" BeforeTargets="ResolveReferences">
    <Error Condition="'@(LocalJson->Count())' != '1' Or '@(LocalNUnit->Count())' != '1'"
           Text="Expected exactly one existing Unity Newtonsoft and NUnit DLL. Do not download dependencies; check local PackageCache paths." />
  </Target>
</Project>
