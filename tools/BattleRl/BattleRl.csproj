<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net8.0</TargetFramework>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems><GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <DefineConstants>$(DefineConstants);NETSTANDARD2_1</DefineConstants><NuGetAudit>false</NuGetAudit>
    <EnableTargetingPackDownload>false</EnableTargetingPackDownload><EnableNETAnalyzers>false</EnableNETAnalyzers>
    <Nullable>annotations</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Assets/Logic/**/*.cs" Exclude="../../Assets/Logic/IsExternalInit.cs" />
    <Compile Include="Program.cs" />
    <Compile Include="CoverageInventory.cs" />
    <Compile Include="JourneyTraining.cs" />
    <Compile Include="JourneyTraining.Atomic.cs" />
    <Compile Include="JourneyTraining.NativePayments.cs" />
    <Compile Include="JourneyTraining.CombatConversions.cs" />
    <Compile Include="JourneyTraining.Tasks.cs" />
    <Compile Include="JourneyTraining.SharedSkills.cs" />
    <Compile Include="JourneyTraining.Shapeshift.cs" />
    <Compile Include="JourneyTraining.World.cs" />
    <Compile Include="JourneyTraining.ObservationBridge.cs" />
    <LocalJson Include="../../Library/PackageCache/com.unity.nuget.newtonsoft-json@*/Runtime/Newtonsoft.Json.dll" />
    <Reference Include="Newtonsoft.Json"><HintPath>@(LocalJson)</HintPath></Reference>
  </ItemGroup>
  <Target Name="RequireExistingDependencies" BeforeTargets="ResolveReferences">
    <Error Condition="'@(LocalJson->Count())' != '1'" Text="Use the existing project Newtonsoft DLL; do not download dependencies." />
  </Target>
</Project>
