{
  "schema": "required-ui-information-spec-v1",
  "version": "cycle02-v2",
  "declaration": "Declared before cycle02 final after_v3 capture/review. after_v2 was rejected for invisible recall caption and is used only as a diagnostic negative case. No retrospective score thresholds.",
  "scope": "Limited necessary textual roles in the 17 fixed contexts. This is not the denominator of all necessary game information. Card-hover artwork and complete native card-face costs/effects require independent original-image reading.",
  "limits": [
    "No score thresholds or human-result claims.",
    "Role count is explicit; repeated enemy components are separately enumerated but does not prove native enemy completeness.",
    "fullText presence is not visible coverage. TMP generated character matching detects ellipsis/substitution; screen quad containment is only geometry.",
    "Actual visible glyph coverage remains null pending independent screenshot reading or glyph pixel masks with draw-order/clip/occlusion evidence.",
    "Text semantic truth and full inventory require native-state assertions; keyword checks are limited content checks.",
    "ResolutionFullText is scrollable inside ResolutionViewport. Full generated text and screen containment DO NOT prove text is currently inside the viewport clip or visible. Scroll reachability/end-to-end visibility needs captured scroll states and independent image reading.",
    "Main ratio denominator is these limited required roles only; role structural/content/generation checks are not an information-completeness score or visible-coverage ratio."
  ],
  "roles": {
    "phase": {
      "path_regex": "/PhaseTrack/PhaseStep_[0-9]+/Phase$",
      "meaning": "当前战斗阶段",
      "required_tokens": [
        "当前"
      ]
    },
    "guidance": {
      "path_regex": "/Inspector/(Details|ResolutionViewport/ResolutionFullText)$",
      "meaning": "当前步骤/所选行动说明，或实际展开回看时的完整结算详情；展开时优先详情，不能以后台Details替代",
      "required_tokens": [],
      "prefer_path_regex": "/Inspector/ResolutionViewport/ResolutionFullText$"
    },
    "feedback": {
      "path_regex": "/Inspector/Feedback$",
      "meaning": "最近操作的确认、拒绝或当前阶段反馈",
      "required_tokens": []
    },
    "resources": {
      "path_regex": "/Status$",
      "meaning": "英雄护甲、创伤、晶体和魔力库存",
      "required_tokens": [
        "护甲",
        "创伤",
        "晶体",
        "魔力"
      ]
    },
    "enemy_rules": {
      "path_regex": "/Enemy_[0-9]+/Numbers$",
      "meaning": "当前各个显示敌人的攻击、护甲、名望及能力行",
      "required_tokens": [
        "攻击",
        "护甲",
        "名望"
      ]
    },
    "enemy_names": {
      "path_regex": "/Enemy_[0-9]+/Name$",
      "meaning": "各个显示敌人的名称",
      "required_tokens": []
    },
    "hand_inventory": {
      "path_regex": "/HandLabel$",
      "meaning": "手牌、牌库、弃牌计数",
      "required_tokens": [
        "手牌",
        "牌库",
        "弃牌"
      ]
    },
    "source_title": {
      "path_regex": "/SourceTitle$",
      "meaning": "公共魔力源选择说明",
      "required_tokens": [
        "公共魔力"
      ]
    },
    "source_gold": {
      "path_regex": "/GoldChoice$",
      "meaning": "金骰支付颜色规则",
      "required_tokens": [
        "金骰",
        "基本色"
      ]
    },
    "receipt": {
      "path_regex": "/ResolutionReceipt/Result$",
      "meaning": "已消费行动的结果回执完整文本",
      "required_tokens": []
    },
    "result_heading": {
      "path_regex": "/Inspector/Heading$",
      "meaning": "战斗结局",
      "required_tokens": []
    },
    "journey_status": {
      "path_regex": "/JourneyStatus$",
      "meaning": "战后延续玩家与牌区、回合状态",
      "required_tokens": [
        "名望",
        "创伤",
        "手牌",
        "牌库"
      ]
    },
    "encounter_prompt": {
      "path_regex": "/EncounterPrompt$",
      "meaning": "选择敌群与幸存敌人规则",
      "required_tokens": [
        "敌群",
        "幸存"
      ]
    },
    "resolution_full": {
      "path_regex": "/Inspector/ResolutionViewport/ResolutionFullText$",
      "meaning": "凝结真实结算的完整效果、免费强化和数值加成适用范围",
      "required_tokens": [
        "凝结",
        "同时打出另一张行动卡牌",
        "免费获得该卡牌的强力效果",
        "移动力、影响力、格挡或任何类型的攻击",
        "该效果数值+2"
      ],
      "clip_visibility_unverified": true
    },
    "recall_caption": {
      "path_regex": "/Inspector/Btn_ResolutionRecall/Label$",
      "meaning": "结果回看/返回入口的真实生成按钮文字",
      "required_tokens": [],
      "any_required_tokens": [
        "返回行动与目标",
        "结算记录"
      ]
    }
  },
