  Bottom:
    Name: "\u9B54\u529B\u8BC5\u5492"
    Effect: "\u4E0E\u57FA\u672C\u6548\u679C\u76F8\u540C\u3002\u6B64\u5916\uFF0C\u5728\u672C\u8F6E\u7ED3\u675F\u524D\uFF1A\u6BCF\u6B21\u5176\u4ED6\u73A9\u5BB6\u5728\u81EA\u5DF1\u56DE\u5408\uFF08\u4ECE\u4EFB\u610F\u6765\u6E90\uFF09\u4F7F\u7528\u4E00\u70B9\u6216\u66F4\u591A\u540C\u8272\u9B54\u529B\uFF0C\u8BE5\u73A9\u5BB6\u53D7\u5230\u4E00\u70B9\u521B\u4F24\u3002\u6BCF\u4F4D\u73A9\u5BB6\u6BCF\u56DE\u5408\u53EA\u4F1A\u4EE5\u6B64\u65B9\u5F0F\u53D7\u5230\u4E00\u70B9\u521B\u4F24\u3002"
