    Name: "\u9B54\u529B\u5BA3\u593A"
    Effect: "\u4ECE\u9B54\u529B\u6E90\u4E2D\u62FF\u53D6\u4E00\u9897\u57FA\u672C\u8272\u9B54\u529B\u9AB0\u5B50\uFF0C\u653E\u5165\u4F60\u7684\u6E38\u620F\u533A\u57DF\u76F4\u5230\u672C\u8F6E\u7ED3\u675F\u3002\u4F60\u53EF\u4EE5\u5728\u672C\u56DE\u5408\u4E2D\u83B7\u5F973\u4E2A\u540C\u8272\u9B54\u529B\u6807\u8BB0\uFF0C\u6216\u8005\u5728\u672C\u8F6E\u4E2D\u63A5\u4E0B\u6765\u7684\uFF08\u4ECE\u4F60\u4E0B\u56DE\u5408\u5F00\u59CB\uFF09\u6BCF\u4E2A\u56DE\u5408\u83B7\u5F97\u4E00\u4E2A\u540C\u8272\u9B54\u529B\u6807\u8BB0\u3002"
