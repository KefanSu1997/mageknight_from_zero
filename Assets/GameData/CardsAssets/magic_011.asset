    Effect: "\u9009\u62E9\u7EFF\u8272\u6216\u767D\u8272\uFF0C\u968F\u540E\u9009\u62E9\u7EA2\u8272\u6216\u84DD\u8272\u3002\u4F60\u7269\u54C1\u680F\u4E2D\u6BCF\u6709\u4E00\u5BF9\u9B54\u6676\uFF08\u6240\u9009\u989C\u8272\u5404\u4E00\uFF09\uFF0C\u83B7\u5F97\u653B\u57CE\u653B\u51FB4\uFF08\u5982\u679C\u9009\u62E9\u4E86\u7EFF\u8272\uFF09\u6216\u8FDC\u7A0B\u653B\u51FB6\uFF08\u5982\u679C\u9009\u62E9\u4E86\u767D\u8272\uFF09\u3002\u6B64\u6B21\u653B\u51FB\u4E3A\u706B\u7130\u653B\u51FB\uFF08\u5982\u679C\u9009\u62E9\u4E86\u7EA2\u8272\uFF09\u6216\u5BD2\u51B0\u653B\u51FB\uFF08\u5982\u679C\u9009\u62E9\u4E86\u84DD\u8272\uFF09\u3002\u968F\u540E\uFF0C\u5C06\u6240\u6709\u914D\u5BF9\u7684\u9B54\u6676\u8F6C\u5316\u4E3A\u9B54\u529B\u3002"
